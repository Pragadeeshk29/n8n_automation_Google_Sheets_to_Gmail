      "parameters": {
        "jsCode": "const students = $input.all().map((item) => item.json);\n\nconst subject = 'Data Summary from Google Sheet';\n\nconst formattedRecords = students\n  .map((s) => {\n    const name = s.name ?? s.Name ?? '';\n    const course = s.course ?? s.Course ?? '';\n    const status = s.status ?? s.Status ?? s.fee_paid ?? s.Fee_Paid ?? '';\n\n    return [\n      `- Name: ${name}`,\n      `- Course: ${course}`,\n      `- Status: ${status}`,\n    ].join('\\n');\n  })\n  .join('\\n\\n');\n\nconst body = [\n  'Hi,',\n  'Here is the latest data from the sheet:',\n  formattedRecords,\n  'Regards,',\n  'Your Automation Bot',\n].join('\\n');\n\nreturn [\n  {\n    json: {\n      subject,\n      body,\n    },\n  },\n];"
      },
